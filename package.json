{
  "name": "yacu",
  "version": "0.1.0",
  "description": "Local coding-agent usage dashboard for the terminal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dropalltables/yacu.git"
  },
  "bugs": {
    "url": "https://github.com/dropalltables/yacu/issues"
  },
  "homepage": "https://github.com/dropalltables/yacu#readme",
  "type": "module",
  "bin": {
    "yacu": "dist/yacu.js"
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "bun src/index.tsx",
    "build": "bun build src/index.tsx --target=bun --packages=external --outfile=dist/yacu.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun test && tsc --noEmit",
    "prepack": "bun run check && bun run build"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "opentui",
    "terminal",
    "tokens",
    "tui",
    "usage"
  ],
  "license": "MIT",
  "author": "Natey Hecht",
  "packageManager": "bun@1.4.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opentui/core": "^0.5.9",
    "@opentui/react": "^0.5.9",
    "gpt-tokenizer": "4.0.0",
    "react": "^19.2.8",
    "tokentally": "^0.1.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "typescript": "^7.0.2"
  }
}
